{
  "apphosting": [
    {
      "backendId": "alice-platform",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".next",
        ".git",
        ".env*",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src/data/knowledge/**/*.png",
        "src/data/knowledge/**/*.PNG",
        "src/data/knowledge/**/*.jpg",
        "src/data/knowledge/**/*.jpeg",
        "src/data/knowledge/**/*.pdf",
        "src/data/knowledge/**/*.pptx"
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
