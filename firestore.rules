rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(orgId) {
      return signedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
    function isOwner(orgId) {
      return signedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }
    match /organizations/{orgId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update: if isMember(orgId) || resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(orgId);

      match /members/{userId} {
        allow read: if isMember(orgId) || isOwner(orgId);
        allow create: if isOwner(orgId);
        allow update, delete: if isOwner(orgId);
      }
      match /bots/{botId} {
        allow read, update: if isMember(orgId) || isOwner(orgId);
        allow create, delete: if false;
        match /{subcollection}/{document=**} {
          allow read, write: if isMember(orgId) || isOwner(orgId);
        }
      }
    }
    match /publicBots/{botId} {
      allow read, write: if false;
    }
  }
}
